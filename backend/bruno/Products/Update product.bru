meta {
  name: Update product
  type: http
  seq: 2
}

put {
  url: http://localhost:3000/api/products/:id
  body: json
  auth: inherit
}

params:path {
  id: 132
}

body:json {
  {
    "name": "Uppdaterad produkt",
    "price": 245,
    "weight": 234,
    "amount": 65,
    "category_id": 3,
    "supplier_id": 3
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
