meta {
  name: Create new product
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/products
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Testprodukt",
    "price": 245,
    "weight": 234,
    "amount": 65,
    "category_id": 9,
    "supplier_id": 9
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
